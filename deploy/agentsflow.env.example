# /etc/agentsflow.env — read by deploy/agentsflow.service. chmod 600, owner root.
# Bot token from @BotFather.
AGENTSFLOW_TELEGRAM_TOKEN=
# Your numeric Telegram ID (ask @userinfobot); only these users may talk to the bot.
AGENTSFLOW_TELEGRAM_USERS=
# 0 turns off sending tasks from Telegram (the bot then only reports).
AGENTSFLOW_TELEGRAM_PROMPTS=1
# Optional: the codex binary when it is not on PATH.
# CODEX_BIN=/home/agentsflow/.npm-global/bin/codex
